---
import '@/styles/post-content.css'
import { render } from 'astro:content'
import Layout from '@/layouts/Layout.astro'
import { formatPostDate, getPosts } from '@/libs/functions'
import { TagCard, PostContentTable } from '@/components/components.ts'
import { ClipboardIcon, CalendarIcon, BookIcon, TagIcon, CloseIcon } from '@/assets/icons/icons'

export async function getStaticPaths() {
    const posts = await getPosts()

    return posts.map(post => ({
        params: { post: post.slug },
        props: { post }
    }))
}

const { post }= Astro.props
const { data } = post
const { title, description, date, readtime, tags } = data
const { Content } = await render(post)


const formatDate = formatPostDate(date)
---

<Layout title={title}>
    <div class="bg-gradient--nav"></div>
    <main class="!gap-4" transition:persist>
        <h1 class="fix px-2 pb-4 pt-8 title-h1 !text-text-highlight-secondary icon-container !gap-2">
                <button 
                title="Toggle table of contents" 
                class="toggle-aside hidden sm:inline btn btn--icon btn--icon--big btn--colored"                
                >
                    <ClipboardIcon />
                </button>
                {title}
            </h1>
        <header class="-translate-y-[1rem]">
            <!-- Title -->
            
            <!-- Data -->
            <section class="flex flex-col gap-4 ml-2">  
                <!-- Date and readtime -->
                <section class="flex flex-row gap-2 items-center text-text-neutral span span--secondary">                
                    <p class="icon-container">
                        <span class="w-5">
                            <CalendarIcon />
                        </span>
                        {formatDate}
                    </p>
                    <div>•</div>
                    <p class="icon-container">
                        <span class="w-5">
                            <BookIcon />
                        </span>
                        {readtime} min read
                    </p>
                </section>
                <!-- Description -->
                <p>{description}</p>
                <!-- Tags -->
                <section>
                    <ul class="flex flex-row flex-wrap items-start gap-2">
                        <span class="icon text-text-highlight-secondary">
                            <TagIcon />
                        </span>
                        { tags.map((tag) => <TagCard tag={tag} type="filled"/>) }
                    </ul>
                </section>
            </section>
        </header>
        <section class="flex flex-row gap-12">
            <article id="post-content" class="content prose dark:prose-invert">
                <Content />
            </article>
            <aside id="post-aside" class="hidden sm:inline relative min-w-[14rem] max-w-[40rem]">
                <section class="fix flex flex-col gap-2 ring-1 ring-muted p-4 pl-8 bg-secondary/2 rounded-md shadow-md">
                    <header class="w-full flex flex-row items-center justify-between">
                        <h3 class="text-nowrap text-text-highlight-secondary font-bold">Table of Contents</h3>
                        <button class="toggle-aside btn btn--icon" title="Close">
                            <CloseIcon />
                        </button>
                    </header>
                    <div>
                        <PostContentTable post={post} />
                    </div>
                </section>
            </aside>
        </section>
    </main>
</Layout>

<script>
    function togglePostAside() {
        const ToggleAsideButtons = document.querySelectorAll('.toggle-aside')
        const postAside = document.getElementById('post-aside')

        const toggleAside = () => {
            postAside?.classList.toggle('sm:inline')            
        }

        ToggleAsideButtons.forEach(button => {
            button.addEventListener('click', toggleAside)
        })

        document.addEventListener('astro:before-preparation', () => {
            ToggleAsideButtons.forEach(button => () => {
                button.removeEventListener('click', toggleAside)
            })
        }, { once: true })
    }

    document.addEventListener('astro:page-load', togglePostAside)
</script>
