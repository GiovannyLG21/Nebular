---
import Layout from '@/layouts/Layout.astro'
import { GithubIcon } from '@/assets/icons/icons'
import { GITHUB_PROFILE } from 'astro:env/client'
import { NoteCard, PostCard } from '@/components/components.ts'
import { getNotes, getPosts } from '@/libs/functions'

const posts = await getPosts().then((val) => val.slice(0, 10))
const notes = await getNotes().then((val) => val.slice(0, 2))
---

<Layout index>			
	<main class="index justify-center items-center">	
		<!-- Introducing -->
		<article class="flex flex-col justify-center items-center gap-4 max-w-[80%] h-[75vh]">
			<h1 class="title-h1 title-h1--big font-bold text-center text-gradient-1">Introducing Astro Nebular!</h1>
			<p class="text-center paragraph paragraph--large prose">Lorem ipsum dolor sit amet consectetur, 
				adipisicing elit. Adipisci temporibus molestias impedit atque recusandae! Expedita culpa libero perferendis 
				reprehenderit accusamus nihil, vel animi quam repellat ut consequatur ex? Corrupti, cupiditate!</p>
				<!-- Github -->
			<div>				
				<a role="button" href={GITHUB_PROFILE} target="_blank" title="Github" 
				class="flex flex-row gap-3 items-center animate opacity-70 hover:opacity-100 hover:text-hover-text-secondary hover:font-semibold">
					Find me on
					<span class="icon icon--big">
						<GithubIcon />
					</span>
				</a>
			</div>
			<!-- Buttons -->
			<div class="flex gap-4 mt-4">
				<a role="button" href="/posts" class="btn btn-gradient">Read Blog</a>
				<a role="button" href="/notes/wake-up" class="btn btn-white">
					<span class="text-gradient-2">Wake up</span>
				</a>
			</div>			
		</article>
		<article class="flex flex-col gap-14 mt-12 xs:mt-0">
			<!-- Posts -->
			<section class="flex flex-col gap-6 w-full">
				<h2 class="title-h2 title-h2--big">Posts</h2>
				<div class="flex flex-col gap-2">
					{ posts.map(post => <PostCard post={post} type="mini"/>) }				
				</div>
			</section>
			<!-- Notes -->
			<section class="flex flex-col gap-6 w-full">
				<h2 class="title-h2 title-h2--big">Notes</h2>
				<div class="flex flex-row flex-wrap gap-6 justify-center items-center">
					{ notes.map(note => <NoteCard note={note}/>) }
				</div>
			</section>		
		</article>
	</main>
</Layout>