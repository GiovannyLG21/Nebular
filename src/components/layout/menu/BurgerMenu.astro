---
import { Entrys } from '@/components/components'
---

<section id="burger-menu" class="burger-menu fixed top-0 left-0 z-100 w-full overflow-hidden bg-gradient animate 
flex flex-col items-center justify-center" transition:persist>
    <ul class="flex flex-col gap-6 items-center justify-center">
        <Entrys className="link link--big" direction="col"/>
        <li>
            <a href="https://astro.build/" id="docs" target="_blank"
            class="link link--nav link--nav--secondary">
                Docs
            </a>
        </li>     
    </ul>
</section>

<style>
    .burger-menu {
        --top-height: 0;
        height: 0;
        top: var(--top-height);
    }

    body[data-menu=active] {
        overflow: hidden;

        .burger-menu {
            height: calc(100% - var(--top-height));
        }

        main,
        footer {
            opacity: 0; 
            pointer-events: none;
        }

        #burger-button {
            .menu-icon {
                width: 0;
            }

            .close-icon {
                width: 100%;
            }
        }    
    }

</style>

<script>
    function burgerMenu() {
        const navbarHeight = document.getElementById('navbar')?.offsetHeight
        const burgerButton = document.getElementById('burger-button')        
        const burgerMenu = document.getElementById('burger-menu')

        if (!navbarHeight || !burgerButton || !burgerMenu) return
        burgerMenu.style.setProperty('--top-height', `${navbarHeight}px`)

        const openBurgerMenu = () => document.body.setAttribute('data-menu', 'active')
        const closeBurgerMenu = () => document.body.removeAttribute('data-menu')

        const toggleMenuStatus = () => {
            const burgerMenuStatus = document.body.getAttribute('data-menu')
            //if is active -> close
            if (burgerMenuStatus) {
                burgerButton.title = 'Open menu'
                return closeBurgerMenu()
            }
            //if is inactive -> open
            openBurgerMenu()
            burgerButton.title = 'Close menu'
        }
    
        burgerButton.addEventListener('click', toggleMenuStatus)  
        //MD: 768px
        window.addEventListener('resize', () => window.innerWidth > 768 ? closeBurgerMenu() : '')

        document.addEventListener('astro:before-preparation', () => {
            burgerButton?.removeEventListener('click', toggleMenuStatus)
        }, { once: true })
    }

    document.addEventListener('astro:page-load', burgerMenu)
</script>