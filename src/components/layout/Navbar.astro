---
import { Image } from 'astro:assets'
import NebularLogo from '@/assets/nebular.png'
import { BurgerMenu, BurgerButton, Entrys, ThemeToggle, SearchButton, Search } from '@/components/components'

interface Props {
    animate?: boolean    
}
const { animate } = Astro.props
---
<nav class="w-full z-100">
    <div id="navbar" class={`flex flex-row justify-between items-center w-full px-2 py-8 ${animate ? 'animate__animated animate__fadeInDown' : ''}`}>
        <div title="Home">
            <a href="/" class="group flex flex-row items-center gap-2">
                <Image src={NebularLogo} alt="Nebular Logo" width="35"/>
                <h1 class="title-h1 animate text-highlight group-hover:!text-hover-text-secondary">Nebular</h1>
            </a>
        </div>
        <!-- Elements md | lg | xl -->
        <div class="hidden md:inline">
            <Entrys className="link--nav" direction="row" gap={4} center docsItem/>
        </div>
        <!-- Search, theme & btn burger -->
        <div class="flex flex-row gap-4">
            <SearchButton />
            <ThemeToggle />
            <!-- Btn burger xs | sm -->
            <BurgerButton />
        </div>
    </div>
    
    <Search />
    <BurgerMenu />
</nav>