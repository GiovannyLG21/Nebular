---
import type { PostType } from '@/libs/functions'

interface Props{
    tag: string,
    posts?: PostType[]
    type?: 'normal' | 'filled'
}

const { tag, posts, type = 'normal' } = Astro.props
---

{ type === 'normal' && (
    <li class="group mx-[1px]">
        <a href={`/tags/${tag}`} class="link link--tag flex items-center gap-1 animate">
            #{tag}
            {posts && (
                <span class="span span--small text-neutral group-hover:text-hover-text animate delay-75">
                    {posts.length} posts
                </span>
            )}
        </a>
    </li>
)}

{ type === 'filled' && (
    <li class="animate ease-out shadow-lg">
        <a href={`/tags/${tag}`} class="px-2 rounded-md text-nowrap bg-secondary hover:bg-secondary/80 text-white dark:text-highlight">
            #{tag}
        </a>
    </li>
)}