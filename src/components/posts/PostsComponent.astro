---
import { type PostType, groupPostsByYear } from '@/libs/functions'
import { PostCard } from '@/components/components'

interface Props {
    groupedPosts: ReturnType<typeof groupPostsByYear>
}
const { groupedPosts } = Astro.props
---

<div class="flex flex-col gap-12">
    { groupedPosts.map(({ year, posts: yearPosts }) => (
        <article class="flex flex-col gap-6">
            <h2 class="title-h2">{year}</h2>
            <section class="flex flex-col gap-4 xs:gap-6">
                { yearPosts.map(post => <PostCard post={post} animation />) }
            </section>
        </article>
    ))}
</div>