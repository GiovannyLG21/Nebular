---
import '@/styles/global.css'
import { ClientRouter } from 'astro:transitions'
import { LoadTheme, Navbar, Footer } from '@/components/components.ts'

interface Props {
	title?: string
	index?: boolean
}
const { title, index = false } = Astro.props
---

<!Doctype html>
<html lang="en" data-index={index}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/x-icon" href="favicon.ico" />
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
		<title>{title ? `${title} • Nebular` : 'Nebular'}</title>
		<ClientRouter/>
		<LoadTheme />
	</head>
	<body>
		<div id="root">
			<Navbar animate={index} />			
			<slot/>	
			<Footer />
		</div>		
	</body>	
</html>

